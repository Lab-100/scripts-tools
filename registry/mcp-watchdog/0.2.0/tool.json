{
  "schema": "invr.tool/1",
  "name": "mcp-watchdog",
  "version": "0.2.0",
  "description": "Демон-страж MCP-серверов и сервисов оркестратора: каждые N секунд проверяет local-llm, firecrawl, MCP_DOCKER, ollama, browsertool, стек INVR, Docker daemon и факт жизни opencode; автовосстанавливает сервисы, ведёт state\\current.json и журнал заявок в requests\\",
  "entry": "mcp-watchdog.ps1",
  "type": "service",
  "requires": {
    "pwsh": ">=7.0"
  },
  "dependencies": [
    "browsertool"
  ],
  "runtime": {
    "stateDir": "C:\\Scripts\\tools\\mcp-watchdog\\state",
    "requestsDir": "C:\\Scripts\\tools\\mcp-watchdog\\requests",
    "logFile": "C:\\Scripts\\Logs\\mcp-watchdog.log",
    "launch": "Start-Process pwsh -ArgumentList '-NoProfile','-File','C:\\Scripts\\tools\\mcp-watchdog.ps1','-RuntimeDir','C:\\Scripts\\tools\\mcp-watchdog' -WindowStyle Hidden"
  },
  "interfaces": {
    "cli": {
      "invoke": "pwsh -File {entry} -RuntimeDir <каталог состояния>",
      "commands": [
        "daemon",
        "Once"
      ]
    }
  },
  "compat": {
    "breaks": []
  },
  "published": "2026-09-26"
}
