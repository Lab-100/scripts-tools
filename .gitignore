# autogenerated by setup-projects.ps1
.venv/
venv/
__pycache__/
*.pyc
node_modules/
.cache/
*.positions.json

# runtime-логи версий инструментов
*.err.log
*.log
*.pid

# Рабочие каталоги инструментов в корне репозитория.
# Ведущий слэш обязателен: без него паттерн съедает одноимённые
# каталоги версий в registry/ (registry/browsertool, registry/mcp-watchdog),
# и инструменты из project.json не попадают в публикуемый репозиторий.
/gh/
/browsertool/
/mcp-watchdog/
/state/

# Каталоги версий в registry/ должны оставаться чистыми: инструменты при
# запуске без -RuntimeDir пишут state/, logs/, requests/, *.pid рядом с
# собой, и эти машинные файлы не должны попадать в публикуемый репозиторий.
registry/**/state/
registry/**/logs/
registry/**/requests/
registry/**/*.pid

# Рабочие каталоги монитора и хранителя в корне (см. также /state/ выше).
/monitor/state/
/monitor/logs/
/mcp-watchdog-guardian/state/

# Локальные пользовательские настройки (приватные): создаются рядом,
# в публичный репозиторий не попадают. Значения по умолчанию — в коде.
/config.local.json
/private.local.json
*.local.json

# Отчёты непрерывной проверки (CI и локальные запуски tools\ci).
# В репозиторий не коммитятся, в GitHub попадают как артефакты сборки.
/artifacts/

# Рабочие каталоги run-watch и orch-metrics в корне (пишут state/ при
# запуске без -RuntimeDir).
/run-watch/
/orch-metrics/

# Линки-развёртки (junction) в tools\<tool> — создаются локером
# resolve-tools для раскладки «инструмент рядом с реестром»; это
# машино-зависимые указатели, а не содержимое, в публикуемый
# репозиторий они не попадают.
/tools/
